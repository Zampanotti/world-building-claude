{
  "name": "world-building-claude",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Atelier local de construction de mondes et d'écriture.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning server/main.ts",
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.8"
  }
}
